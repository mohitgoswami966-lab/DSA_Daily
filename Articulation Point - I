class Solution {
	private:
	void dfs(int node, int &timer, int parent, vector<int> &disc, vector<int> &low,
	vector<int> adj[], vector<bool> &visited, vector<int> &result) {
		visited[node] = true;
		disc[node] = low[node] = timer++;
		int child = 0;
		for (auto i:adj[node]) {
			if (i == parent)
				continue;
			else if (!visited[i]) {
				dfs(i, timer, node, disc, low, adj, visited, result);
				low[node] = min(low[node], low[i]);
				if (low[i] >= disc[node] && parent != -1) {
					result[node] = 1;
				}
				child++;
			}
			else {
				low[node] = min(low[node], disc[i]);
			}
		}
		if (parent == -1 && child>1) {
			result[node] = 1;
		}
	}
	public:
	vector<int> articulationPoints(int V, vector<int> adj[]) {
		
		vector<int> result(V, 0);
		vector<bool> visited(V, false);
		vector<int> disc(V, -1);
		vector<int> low(V, -1);
		int timer = 0;
		int parent = -1;
		
		for (int i = 0; i<V; i++) {
			if (!visited[i]) {
				dfs(i, timer, parent, disc, low, adj, visited, result);
			}
		}
		vector<int> ans;
		
		for (int i = 0; i < V; i++) {
			if (result[i])
				ans.push_back(i);
		}
		
		if (ans.empty())
			return {-1};
		
		return ans;
	}
};
