class Solution {
private:
    void dfs(int row,int col,vector<vector<int>> &visited,vector<vector<char>> &board,int aRow[],int aCol[]){
        visited[row][col]=1;
        int n=board.size();
        int m=board[0].size();
        for(int i=0;i<4;i++){
            int nrow=row+aRow[i];
            int ncol=col+aCol[i];
            if((nrow>=0 && nrow<n) && (ncol>=0 && ncol<m) && !visited[nrow][ncol] && board[nrow][ncol]=='O'){
                dfs(nrow,ncol,visited,board,aRow,aCol);
            }
        }
    }
public:
    void solve(vector<vector<char>>& board) {
        int aRow[]={-1,0,1,0};
        int aCol[]={0,+1,0,-1};
        int n=board.size();
        int m=board[0].size();
        vector<vector<int>> visited(n,vector<int> (m,0));
        for(int i=0;i<m;i++){
            if(board[0][i]=='O' && !visited[0][i]){
                dfs(0,i,visited,board,aRow,aCol);
            }
            if(board[n-1][i]=='O' && !visited[n-1][i]){
                dfs(n-1,i,visited,board,aRow,aCol);
            }
        }
        for(int j=0;j<n;j++){
            if(board[j][0]=='O' && !visited[j][0]){
                dfs(j,0,visited,board,aRow,aCol);
            }
            if(board[j][m-1]=='O' && !visited[j][m-1]){
                dfs(j,m-1,visited,board,aRow,aCol);
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(!visited[i][j] && board[i][j]=='O'){
                    board[i][j]='X';
                }
            }
        }
    }
};
