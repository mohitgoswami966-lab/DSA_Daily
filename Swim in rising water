class Solution {
public:
    int swimInWater(vector<vector<int>>& grid) {
        int n=grid.size();
        priority_queue<vector<int>,vector<vector<int>>,greater<vector<int>>> pq;
        vector<vector<int>> visited(n,vector<int> (n,0));
        pq.push({grid[0][0],0,0});
        visited[0][0]=1;
        int aRow[]={-1,0,1,0};
        int aCol[]={0,1,0,-1};
        while(!pq.empty()){
            auto curr=pq.top();
            pq.pop();
            int time=curr[0];
            int r=curr[1];
            int c=curr[2];
            if(r==n-1 && c==n-1) return time;
            for(int i=0;i<4;i++){
                int newR=r+aRow[i];
                int newC=c+aCol[i];
                if((newR>=0 && newR<n) && (newC>=0 && newC<n) && !visited[newR][newC]){
                    visited[newR][newC]=1;
                    pq.push(
                        {max(time,grid[newR][newC]),newR,newC}
                    );
                }
            }
        }
        return -1;
    }
};
