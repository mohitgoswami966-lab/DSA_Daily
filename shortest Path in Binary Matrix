class Solution {
public:
    int shortestPathBinaryMatrix(vector<vector<int>>& grid) {
        int n=grid.size();
         if (grid[0][0] == 1 || grid[n - 1][n - 1] == 1)
            return -1;

        if (n == 1)
            return 1;
        queue<pair<int,pair<int,int>>> q;
        q.push({1, {0, 0}});
        grid[0][0] = 1;
        int ans=0;
        int aRow[]={-1,-1,-1,0,0,1,1,1};
        int aCol[]={-1,0,1,-1,1,-1,0,1};
        while(!q.empty()){
            int d=q.front().first;
            int r=q.front().second.first;
            int c=q.front().second.second;
            q.pop();
            for(int i=0;i<8;i++){
                int nrow=r+aRow[i];
                int ncol=c+aCol[i];
                if((nrow>=0 && nrow<n) && (ncol>=0 && ncol<n) && grid[nrow][ncol]==0){
                    if(nrow==n-1 && ncol==n-1){
                        return d+1;
                    }
                    grid[nrow][ncol] = 1;
                    q.push({d+1,{nrow,ncol}});
                }
            }
        }
        return -1;
    }
};
