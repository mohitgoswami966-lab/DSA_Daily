class Solution {
public:
    int leastInterval(vector<char>& tasks, int n) {
        int maxFreq=0;
        vector<int> freq(26,0);
        for(auto c:tasks){
            freq[c-'A']++;
            maxFreq=max(maxFreq,freq[c-'A']);
        }
        int maxCount=0;
        for(auto f:freq){
            if(f==maxFreq){
                maxCount++;
            }
        }
        int ans=(maxFreq-1)*(n+1)+maxCount;
        return max(ans,(int)tasks.size());
    }
};
